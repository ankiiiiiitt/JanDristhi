# ==============================================================================
# JanDrishti - Shared Hackathon Environment Configuration
# Copy this file to .env before starting development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL SYSTEM SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=hackathon-super-secret-key-change-in-production-2025
API_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. BACKEND (FastAPI - Developer 3)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MOCK_MODE=false # Set to true to bypass MongoDB and run with in-memory contract mock data

# ------------------------------------------------------------------------------
# 3. DATABASE (MongoDB Atlas - Developer 4)
# Replace with your team's MongoDB Atlas cluster connection string:
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.jandrishti.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jandrishti_dev
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 4. AI ENGINE & INFERENCE (Developer 2)
# ------------------------------------------------------------------------------
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8001
AI_MODEL_PATH=ai-engine/weights/best_road_damage.pt
AI_CONFIDENCE_THRESHOLD=0.35
AI_IOU_THRESHOLD=0.45
AI_DEVICE=cpu # cpu or cuda or mps

# ------------------------------------------------------------------------------
# 5. FRONTEND (React + Vite - Developer 1)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MOCK_FALLBACK=true
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13

# ------------------------------------------------------------------------------
# 6. DATA COLLECTION & TELEMETRY (Developer 5)
# ------------------------------------------------------------------------------
VEHICLE_SIMULATOR_SPEED_KMPH=40
TELEMETRY_INTERVAL_SECONDS=2
UPLOAD_STORAGE_DIR=backend/uploads

