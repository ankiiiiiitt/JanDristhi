# ════════════════════════════════════════════════════════════════
# JanDrishti – Production / Deployment Environment Template
# ════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# ── Backend ───────────────────────────────────────────────────
# MongoDB Atlas connection string (get from atlas.mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jandrishti_prod

# Backend server
ENVIRONMENT=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8199

# CORS: comma-separated list of allowed frontend origins
# Example: https://jandrishti.vercel.app,https://www.jandrishti.in
BACKEND_CORS_ORIGINS=["https://your-app.vercel.app"]

# File uploads (use /tmp/uploads on Render/Railway free tier)
UPLOAD_STORAGE_DIR=/tmp/uploads

# Secret key for JWT tokens – generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX

# ── Frontend (Vite) ───────────────────────────────────────────
# Replace with your deployed backend URL after deploying backend
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1

# Chandigarh map defaults (no API key needed – uses OSM)
VITE_MAP_DEFAULT_LAT=30.7333
VITE_MAP_DEFAULT_LNG=76.7794
VITE_MAP_DEFAULT_ZOOM=13
